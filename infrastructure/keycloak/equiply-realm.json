{
  "realm": "equiply",
  "enabled": true,
  "displayName": "Equiply",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "roles": {
    "realm": [
      { "name": "OWNER", "description": "Organization owner" },
      { "name": "MANAGER", "description": "Operations manager" },
      { "name": "EMPLOYEE", "description": "Operations employee" },
      { "name": "PLATFORM_ADMIN", "description": "Equiply platform administrator" }
    ]
  },
  "clients": [
    {
      "clientId": "equiply-web",
      "name": "Equiply Web",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["http://localhost:3000", "http://localhost:3000/dashboard*"],
      "webOrigins": ["http://localhost:3000"],
      "protocol": "openid-connect",
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "protocolMappers": [
        {
          "name": "organization_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "organization_id",
            "claim.name": "organization_id",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "owner@equiply.local",
      "email": "owner@equiply.local",
      "firstName": "Luis",
      "lastName": "Flores",
      "enabled": true,
      "emailVerified": true,
      "attributes": {
        "organization_id": ["11111111-1111-1111-1111-111111111111"]
      },
      "realmRoles": ["OWNER"],
      "credentials": [
        {
          "type": "password",
          "value": "Equiply123!",
          "temporary": false
        }
      ]
    }
  ]
}
